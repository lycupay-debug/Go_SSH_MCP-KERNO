# Example only. Copy to /usr/local/etc/kerno.conf and chmod 600.
# If password authentication is required, configure the password securely; never commit it.
LISTEN_ADDR=127.0.0.1:8766
PUBLIC_ISSUER_URL=https://mcp.example.com
RESOURCE_URL=https://mcp.example.com/mcp
DATABASE_URL=postgres://kerno_user@127.0.0.1:5432/kerno?sslmode=disable
C_EXECUTOR_PATH=/opt/kerno/bin/host-executor
MAX_OUTPUT_BYTES=1048576
OAUTH_SIGNING_KEY_FILE=/usr/local/etc/kerno.secret
AUDIT_LOG_PATH=/var/log/kerno-audit.log
